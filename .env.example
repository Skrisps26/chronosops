# Copy to .env for local Compose interpolation. Passwords are generated in .secrets/db.env.
AWS_REGION=us-east-1
AWS_REGION_NAME=us-east-1
AWS_PROFILE=
BEDROCK_LLM_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSION=256
LLM_MAX_TOKENS=1024
LLM_EXTRACTION_MAX_TOKENS=2048

FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_ADMIN_USERNAME=admin
FALKORDB_READER_ACME_USERNAME=reader_acme
FALKORDB_READER_GLOBEX_USERNAME=reader_globex
FALKORDB_WRITER_ACME_USERNAME=writer_acme
FALKORDB_WRITER_GLOBEX_USERNAME=writer_globex
FALKORDB_QUERY_TIMEOUT_MS=3000

PUBLIC_ORIGIN=http://localhost:8080
DEMO_MODE=live
# Operator-only kill switch. Keep false outside a verified controlled rehearsal.
REAL_RECOVERY_ENABLED=false
# Container mounts only: uncomment when running containerized with credentials mounted
# AWS_SHARED_CREDENTIALS_FILE=/run/aws/credentials
# AWS_CONFIG_FILE=/run/aws/config

DEMO_STACK_NAME=chronosops-demo
DEMO_INSTANCE_ID=
DEMO_AWS_ACCOUNT_ID=
DEMO_RECOVERY_DOCUMENT=
DEMO_RECOVERY_DOCUMENT_VERSION=
DEMO_RECOVERY_DOCUMENT_HASH=
PROMETHEUS_URL=http://prometheus:9090
SLACK_TEAM_ID=
SLACK_CHANNEL_ID=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
ALERT_WEBHOOK_TOKEN=
